        "SW2.8_USER_SW3": "OFF"
    },

    "udp_command_protocol": {
        "_description": "DCA1000 UDP command packet format",
        "header": "0xA55A",
        "footer": "0xEEAA",
        "packet_structure": "[header:2bytes][cmd_code:2bytes][data_length:2bytes][data:variable][footer:2bytes]",
        
        "commands": {
            "RESET_FPGA": {
                "code": "0x0100",
                "data": "none",
                "description": "Reset the FPGA"
            },
            "RESET_AR_DEV": {
                "code": "0x0200",
                "data": "none",
                "description": "Reset the connected radar device"
            },
            "CONFIG_FPGA_GEN": {
                "code": "0x0300",
                "data": "6 bytes - logging_mode(2) + lvds_mode(2) + data_transfer_mode(2) + data_capture_mode(2) + data_format_mode(2) + timer(2)",
                "description": "Configure FPGA general settings",
                "working_data_hex": "01000200010002000300 1E00",
                "working_data_description": "raw=1, lvds_2lane=2, capture=1, ethernet=2, 16bit=3, timer=30"
            },
            "CONFIG_PACKET_DATA": {
                "code": "0x0B00",
                "data": "2 bytes - packet_delay in us (little-endian)",
                "description": "Configure delay between data packets",
                "working_data_hex": "1900",
                "working_data_description": "25 us delay"
            },
            "START_RECORD": {
                "code": "0x0500",
                "data": "none",
                "description": "Arm DCA1000 to start recording (send BEFORE triggering radar frames)"
            },
            "STOP_RECORD": {
                "code": "0x0600",
                "data": "none",
                "description": "Stop recording"
            },
            "SYSTEM_CONNECT": {
                "code": "0x0900",
                "data": "none",
                "description": "Check if DCA1000 is connected and responsive"
            },
            "READ_FPGA_VERSION": {
                "code": "0x0E00",
                "data": "none",
                "description": "Read FPGA firmware version"
            }
        },

        "response_format": {
            "header": "0xA55A",
            "footer": "0xEEAA",
            "structure": "[header:2bytes][cmd_code:2bytes][status:2bytes][footer:2bytes]",
            "status_codes": {
                "0x0000": "Success",
                "0x0001": "Failure"
            }
        }
    },

    "raw_data_packet_format": {
        "_description": "Format of UDP packets received on data port (4098)",
        "header_size_bytes": 10,
        "header_fields": {
            "sequence_number": "4 bytes (little-endian uint32)",
            "byte_count": "6 bytes (little-endian uint48, total bytes transferred)"
        },
        "payload": "Raw ADC samples, 16-bit signed integers, I/Q interleaved",
        "max_packet_size_bytes": 1472,
        "payload_per_packet_bytes": 1462,
        "sample_format": {
            "bits_per_sample": 16,
            "type": "signed int16 (little-endian)",
            "interleaving": "I, Q, I, Q, ... for each RX channel",
            "channel_interleaving": "All samples for RX0, then RX1, etc. within each chirp"
        }
    },

    "radar_parameters_for_parsing": {
